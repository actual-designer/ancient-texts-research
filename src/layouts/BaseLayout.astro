---
// The Chronos Archive — Base Layout
// HTML shell, theme system, responsive 3-zone layout (sidebar + reading
// column + optional TOC rail), and the bundled Mermaid runtime.
import Sidebar from '../components/Sidebar.astro';
import TopBar from '../components/TopBar.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import BackToTop from '../components/BackToTop.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Mermaid from '../components/Mermaid.astro';
import '../styles/theme.css';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  headings?: { depth: number; id: string; text: string }[];
}

const {
  title = 'The Chronos Archive',
  description = 'A forensic, technological reconstruction of humanity\'s forgotten history — reverse-engineering ancient texts as corrupted technical manuals.',
  headings = [],
} = Astro.props;

const base = import.meta.env.BASE_URL || '/';
const hasToc = headings.length > 0;
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d0e12" />

    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site || 'https://actual-designer.github.io/ancient-texts-research').href} />

    <!-- Fonts (non-blocking) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;1,8..60,400&family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600&family=JetBrains+Mono:ital,wght@0,400;0,500;1,400&display=swap"
    />

    <title>{title}</title>

    <!-- Prevent flash of wrong theme; sync theme-color meta before paint -->
    <script is:inline>
      (function () {
        var saved = localStorage.getItem('chronos-theme');
        var theme;
        if (saved === 'light' || saved === 'dark') {
          theme = saved;
        } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) {
          theme = 'light';
        } else {
          theme = 'dark';
        }
        if (theme === 'light') {
          document.documentElement.setAttribute('data-theme', 'light');
        }
        document.documentElement.classList.remove('no-js');
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', theme === 'light' ? '#faf7f0' : '#0d0e12');
      })();
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>

    <Sidebar />
    <TopBar />

    <main id="main-content" class="main-content">
      <div class:list={['reading-shell', { 'has-toc': hasToc }]}>
        <div class="content-col">
          <slot />
        </div>
        {hasToc && (
          <div class="toc-rail">
            <TableOfContents headings={headings} />
          </div>
        )}
      </div>
    </main>

    <ReadingProgress />
    <BackToTop />
    <Mermaid />
  </body>
</html>

<style>
  .main-content {
    margin-left: var(--sidebar-width);
    padding: var(--space-2xl) var(--content-padding) var(--space-3xl);
    min-height: 100vh;
    position: relative;
    z-index: 1;
  }

  .reading-shell {
    margin-inline: auto;
    max-width: var(--content-max-width);
  }

  .content-col {
    min-width: 0;
  }

  .toc-rail {
    display: none;
  }

  /* ── Wide screens: reading column + sticky TOC rail ── */
  @media (min-width: 1200px) {
    .reading-shell.has-toc {
      max-width: calc(var(--content-max-width) + var(--toc-width) + var(--space-2xl));
      display: grid;
      grid-template-columns: minmax(0, 1fr) var(--toc-width);
      gap: var(--space-2xl);
      /* Stretch the TOC rail to the full article height so position:sticky
         on .toc has room to stay pinned for the entire scroll. */
      align-items: stretch;
    }

    .reading-shell.has-toc .toc-rail {
      display: block;
      min-height: 0;
    }
  }

  /* ── Mobile: full-width content under the top bar ── */
  @media (max-width: 768px) {
    .main-content {
      margin-left: 0;
      padding: calc(var(--topbar-height) + var(--space-lg)) var(--content-padding) var(--space-2xl);
    }
  }
</style>
