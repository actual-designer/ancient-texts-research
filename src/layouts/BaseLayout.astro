---
// The Chronos Archive — Base Layout
// Provides HTML shell, Mermaid CDN, and dark Archive aesthetic.
import Sidebar from '../components/Sidebar.astro';

export interface Props {
  title?: string;
  description?: string;
}

const { title = 'The Chronos Archive', description = 'A forensic, technological reconstruction of humanity\'s forgotten history — reverse-engineering ancient texts as corrupted technical manuals.' } = Astro.props;
const base = import.meta.env.BASE_URL || '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d1117" />

    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site || 'https://actual-designer.github.io/ancient-texts-research').href} />

    <title>{title}</title>

    <!-- Mermaid CDN -->
    <script defer src="https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js"
      onload="mermaid.initialize({startOnLoad:true, theme:'dark', themeVariables:{darkMode:true}})">
    </script>
  </head>
  <body>
    <Sidebar />

    <main class="main-content">
      <slot />
    </main>
  </body>
</html>

<style>
  /* ── Reset & Base ── */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    -webkit-text-size-adjust: 100%;
    -moz-text-size-adjust: 100%;
    text-size-adjust: 100%;
  }

  body {
    margin: 0;
    padding: 0;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: #c9d1d9;
    background: #0d1117;
    min-height: 100vh;
  }

  /* ── Scrollbar (Webkit) ── */
  ::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }

  ::-webkit-scrollbar-track {
    background: #0d1117;
  }

  ::-webkit-scrollbar-thumb {
    background: #30363d;
    border-radius: 4px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: #484f58;
  }

  /* ── Main Content ── */
  .main-content {
    margin-left: 260px;
    padding: 32px 48px;
    max-width: 960px;
    min-height: 100vh;
  }

  /* ── Typography ── */
  h1, h2, h3, h4, h5, h6 {
    color: #e6edf3;
    font-weight: 600;
    line-height: 1.3;
    margin-top: 1.5em;
    margin-bottom: 0.5em;
  }

  h1 { font-size: 2em; border-bottom: 1px solid #21262d; padding-bottom: 0.3em; }
  h2 { font-size: 1.5em; border-bottom: 1px solid #21262d; padding-bottom: 0.25em; }
  h3 { font-size: 1.25em; }
  h4 { font-size: 1em; }

  p {
    margin: 0 0 1em;
  }

  a {
    color: #58a6ff;
    text-decoration: none;
  }

  a:hover {
    color: #79c0ff;
    text-decoration: underline;
  }

  strong {
    color: #e6edf3;
  }

  blockquote {
    margin: 1em 0;
    padding: 0 1em;
    color: #8b949e;
    border-left: 3px solid #30363d;
  }

  hr {
    border: none;
    border-top: 1px solid #21262d;
    margin: 1.5em 0;
  }

  /* ── Lists ── */
  ul, ol {
    padding-left: 2em;
    margin-bottom: 1em;
  }

  li {
    margin-bottom: 0.25em;
  }

  /* ── Code ── */
  code {
    font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
    font-size: 0.875em;
    background: #161b22;
    padding: 0.2em 0.4em;
    border-radius: 4px;
    color: #e6edf3;
  }

  pre {
    background: #161b22;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 16px;
    overflow-x: auto;
    margin-bottom: 1em;
  }

  pre code {
    background: none;
    padding: 0;
    border-radius: 0;
    color: inherit;
    font-size: 0.875em;
    line-height: 1.5;
  }

  /* ── Tables ── */
  table {
    border-collapse: collapse;
    width: 100%;
    margin-bottom: 1em;
    font-size: 0.9375em;
  }

  thead {
    border-bottom: 2px solid #30363d;
  }

  th, td {
    padding: 8px 12px;
    border: 1px solid #21262d;
    text-align: left;
    vertical-align: top;
  }

  th {
    background: #161b22;
    color: #e6edf3;
    font-weight: 600;
  }

  tr:nth-child(even) {
    background: #161b22;
  }

  tr:hover {
    background: #1c2128;
  }

  /* Responsive table wrapper */
  .table-wrapper,
  .main-content > table,
  .main-content :where(table) {
    display: block;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  /* ── Images ── */
  img {
    max-width: 100%;
    height: auto;
    border-radius: 6px;
  }

  /* ── Mobile (≤768px) ── */
  @media (max-width: 768px) {
    .main-content {
      margin-left: 0;
      padding: 48px 20px 32px;
    }
  }
</style>
