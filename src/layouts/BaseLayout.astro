---
// The Chronos Archive — Base Layout
// Provides HTML shell, Mermaid CDN, theme system, and dark Archive aesthetic.
import Sidebar from '../components/Sidebar.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import BackToTop from '../components/BackToTop.astro';
import '../styles/theme.css';

export interface Props {
  title?: string;
  description?: string;
}

const { title = 'The Chronos Archive', description = 'A forensic, technological reconstruction of humanity\'s forgotten history — reverse-engineering ancient texts as corrupted technical manuals.' } = Astro.props;
const base = import.meta.env.BASE_URL || '/';
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d0e12" media="(prefers-color-scheme: dark)">
    <meta name="theme-color" content="#faf7f0" media="(prefers-color-scheme: light)">

    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site || 'https://actual-designer.github.io/ancient-texts-research').href} />

    <title>{title}</title>

    <!-- Prevent flash of wrong theme -->
    <script is:inline>
      (function() {
        var saved = localStorage.getItem('chronos-theme');
        if (saved === 'light') {
          document.documentElement.setAttribute('data-theme', 'light');
        } else if (saved === 'dark') {
          // explicit dark: keep default (no attribute = dark)
        } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
        document.documentElement.classList.remove('no-js');
      })();
    </script>

    <!-- Mermaid CDN -->
    <script defer src="https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js"
      onload="(function(){var t=document.documentElement.getAttribute('data-theme')==='light'?'default':'dark';mermaid.initialize({startOnLoad:true,theme:t})})()">
    </script>
  </head>
  <body>
    <Sidebar />

    <main class="main-content">
      <slot />
    </main>

    <ReadingProgress />
    <BackToTop />

    <script is:inline>
      // Transform Shiki-highlighted mermaid blocks into raw <pre class="mermaid">
      // Must run before Mermaid's deferred init (which is in <head> with defer)
      document.querySelectorAll('pre[data-language="mermaid"]').forEach(function(pre) {
        var code = pre.querySelector('code');
        if (!code) return;
        var wrapper = document.createElement('pre');
        wrapper.className = 'mermaid';
        wrapper.textContent = code.textContent;
        pre.replaceWith(wrapper);
      });
    </script>
  </body>
</html>

<style>
  /* ── Reset & Base ── */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    -webkit-text-size-adjust: 100%;
    -moz-text-size-adjust: 100%;
    text-size-adjust: 100%;
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
    font-size: var(--step-0);
    line-height: 1.75;
    color: var(--text-primary);
    background: var(--bg-primary);
    min-height: 100vh;
    position: relative;
  }

  /* Vignette overlay */
  body::after {
    content: '';
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background: radial-gradient(
      circle at center,
      transparent 0%,
      var(--vignette-color) var(--vignette-strength)
    );
  }

  /* Selection */
  ::selection {
    background: var(--selection-bg);
    color: var(--selection-text);
  }

  /* ── Scrollbar ── */
  ::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }

  ::-webkit-scrollbar-track {
    background: var(--scrollbar-track);
  }

  ::-webkit-scrollbar-thumb {
    background: var(--scrollbar-thumb);
    border-radius: 4px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--scrollbar-thumb-hover);
  }

  /* ── Main Content ── */
  .main-content {
    margin-left: var(--sidebar-width);
    padding: var(--space-2xl) var(--content-padding);
    max-width: var(--content-max-width);
    min-height: 100vh;
    position: relative;
    z-index: 1;
  }

  /* ── Typography ── */
  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-heading);
    color: var(--text-heading);
    font-weight: 600;
    line-height: 1.3;
    margin-top: 1.5em;
    margin-bottom: 0.5em;
  }

  h1 {
    font-size: var(--step-4);
    border-bottom: 1px solid var(--divider);
    padding-bottom: 0.2em;
  }

  h2 {
    font-size: var(--step-2);
    border-bottom: 1px solid var(--divider);
    padding-bottom: 0.15em;
  }

  h3 {
    font-size: var(--step-1);
  }

  h4 {
    font-size: var(--step-0);
  }

  p {
    margin: 0 0 1em;
  }

  a {
    color: var(--accent);
    text-decoration: none;
  }

  a:hover {
    color: var(--accent-hover);
    text-decoration: underline;
  }

  strong {
    color: var(--text-heading);
  }

  blockquote {
    margin: 1em 0;
    padding: 0 1em;
    color: var(--text-secondary);
    border-left: 3px solid var(--accent);
  }

  hr {
    border: none;
    border-top: 1px solid var(--divider);
    margin: 1.5em 0;
  }

  /* ── Lists ── */
  ul, ol {
    padding-left: 2em;
    margin-bottom: 1em;
  }

  li {
    margin-bottom: 0.25em;
  }

  /* ── Code ── */
  code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--code-bg);
    padding: 0.2em 0.4em;
    border-radius: var(--radius-sm);
    color: var(--code-text);
    border: 1px solid var(--code-border);
  }

  pre {
    background: var(--code-bg);
    border: 1px solid var(--code-border);
    border-radius: var(--radius-md);
    padding: 16px;
    overflow-x: auto;
    margin-bottom: 1em;
  }

  pre code {
    background: none;
    padding: 0;
    border-radius: 0;
    border: none;
    color: inherit;
    font-size: 0.875em;
    line-height: 1.5;
  }

  /* ── Tables ── */
  table {
    border-collapse: collapse;
    width: 100%;
    margin-bottom: 1em;
    font-size: 0.9375em;
  }

  thead {
    border-bottom: 2px solid var(--border);
  }

  th, td {
    padding: 8px 12px;
    border: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
  }

  th {
    background: var(--bg-secondary);
    color: var(--text-heading);
    font-weight: 600;
  }

  tr:nth-child(even) {
    background: var(--bg-secondary);
  }

  tr:hover {
    background: var(--bg-tertiary);
  }

  /* Responsive table wrapper */
  .table-wrapper,
  .main-content > table,
  .main-content :where(table) {
    display: block;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    /* Scroll shadow on right edge when content overflows */
    background:
      linear-gradient(to right, var(--bg-primary) 30%, transparent),
      linear-gradient(to right, transparent, var(--bg-primary) 70%) 100% 0,
      linear-gradient(to right, var(--border) 0%, transparent 50%),
      linear-gradient(to left, var(--border) 0%, transparent 50%) 100% 0;
    background-repeat: no-repeat;
    background-size: 40px 100%, 40px 100%, 14px 100%, 14px 100%;
    background-attachment: local, local, scroll, scroll;
  }

  /* ── Images ── */
  img {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-md);
  }

  /* ── Mobile (≤768px) ── */
  @media (max-width: 768px) {
    .main-content {
      margin-left: 0;
      padding: 48px 20px 32px;
    }
  }
</style>