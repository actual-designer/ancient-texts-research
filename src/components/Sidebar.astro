---
// The Chronos Archive — Sidebar Navigation
// Desktop: persistent left rail. Mobile: off-canvas drawer (toggled by the
// hamburger in TopBar). Groups: Syntheses, Field Notes, Analyses.
import ThemeToggle from './ThemeToggle.astro';

const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL || '/';

interface NavItem {
  label: string;
  href: string;
}

const syntheses: NavItem[] = [
  { label: '00 — Index', href: `${base}audit/00-index/` },
  { label: '01 — Entity Registry', href: `${base}audit/01-entity-registry/` },
  { label: '02 — Technology Catalog', href: `${base}audit/02-technology-catalog/` },
  { label: '03 — Event Timeline', href: `${base}audit/03-event-timeline/` },
  { label: '04 — Cross-References', href: `${base}audit/04-cross-references/` },
  { label: '05 — Great Reset', href: `${base}audit/05-great-reset/` },
  { label: '06 — Weapons Doctrine', href: `${base}audit/06-weapons-doctrine/` },
  { label: '07 — Human Project', href: `${base}audit/07-the-human-project/` },
  { label: '08 — Translation Key', href: `${base}audit/08-translation-key/` },
  { label: '09 — Location Registry', href: `${base}audit/09-location-registry/` },
  { label: '10 — Correlation Map', href: `${base}audit/10-correlation-map/` },
  { label: '11 — Unified Hypothesis', href: `${base}audit/11-unified-hypothesis/` },
  { label: '12 — NHI Correlation', href: `${base}audit/12-nhi-correlation/` },
  { label: '13 — NDE Correlation', href: `${base}audit/13-nde-correlation/` },
  { label: '14 — Celestial Events', href: `${base}audit/14-broadsheet-celestial-events/` },
];

const fieldNotes: NavItem[] = [
  { label: 'Control Baseline', href: `${base}audit/control-baseline-vadersolstavlan/` },
  { label: 'Broadsheet Methodology', href: `${base}audit/research-notes-broadsheet-methodology/` },
];

const analyses: NavItem[] = [
  { label: 'Atrahasis', href: `${base}audit/analyses/atrahasis/` },
  { label: 'Book of Enoch', href: `${base}audit/analyses/enoch-watchers/` },
  { label: 'Gilgamesh', href: `${base}audit/analyses/gilgamesh/` },
  { label: 'Ezekiel', href: `${base}audit/analyses/ezekiel-merkabah/` },
  { label: 'Mahābhārata', href: `${base}audit/analyses/mahabharata/` },
  { label: 'Popol Vuh', href: `${base}audit/analyses/popol-vuh/` },
  { label: 'Pyramid Texts', href: `${base}audit/analyses/pyramid-texts/` },
  { label: 'Rig Veda', href: `${base}audit/analyses/rig-veda/` },
  { label: 'Revelation', href: `${base}audit/analyses/revelation/` },
  { label: 'Book of the Dead', href: `${base}audit/analyses/book-of-the-dead/` },
  { label: 'Poetic Edda', href: `${base}audit/analyses/poetic-edda/` },
  { label: 'Theogony & Works and Days', href: `${base}audit/analyses/theogony-works-and-days/` },
  { label: 'Zoroastrian Gathas', href: `${base}audit/analyses/zoroastrian-gathas/` },
  { label: 'Yoga Sutras', href: `${base}audit/analyses/yoga-sutras/` },
];

function isActive(href: string): boolean {
  return currentPath === href || currentPath.replace(/\/$/, '') === href.replace(/\/$/, '');
}

const sections: { heading: string; items: NavItem[] }[] = [
  { heading: 'Syntheses', items: syntheses },
  { heading: 'Field Notes', items: fieldNotes },
  { heading: 'Analyses', items: analyses },
];
---

<div class="sidebar-overlay" aria-hidden="true"></div>
<nav id="archive-sidebar" class="sidebar" aria-label="Archive navigation">
  <div class="sidebar-content">
    <div class="sidebar-header">
      <a href={base} class="sidebar-home">The Chronos Archive</a>
      <div class="sidebar-header-actions">
        <ThemeToggle />
        <button class="sidebar-close" aria-label="Close navigation menu">&times;</button>
      </div>
    </div>

    {sections.map((section) => (
      <section class="sidebar-section">
        <h2 class="sidebar-heading">{section.heading}</h2>
        <hr class="sidebar-heading-rule" />
        <ul class="sidebar-list">
          {section.items.map((item) => (
            <li class="sidebar-item">
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={{ 'sidebar-link': true, 'sidebar-link--active': isActive(item.href) }}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <div class="sidebar-footer">&copy; The Chronos Archive</div>
  </div>
</nav>

<style>
  /* ── Sidebar Container ── */
  .sidebar {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: var(--sidebar-width);
    background: var(--bg-secondary);
    border-right: 1px solid var(--border);
    overflow-y: auto;
    overscroll-behavior: contain;
    z-index: 100;
    display: flex;
    flex-direction: column;
  }

  /* ── Overlay ── */
  .sidebar-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    z-index: 99;
  }

  .sidebar-overlay[data-visible] {
    display: block;
  }

  /* ── Close button (mobile only) ── */
  .sidebar-close {
    display: none;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    cursor: pointer;
    width: 32px;
    height: 32px;
    font-size: 20px;
    line-height: 1;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  .sidebar-close:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* ── Content ── */
  .sidebar-content {
    padding: 18px 0 8px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .sidebar-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-sm);
    padding: 0 18px 16px;
    border-bottom: 1px solid var(--divider);
    margin-bottom: 14px;
  }

  .sidebar-header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .sidebar-home {
    font-family: var(--font-heading);
    font-size: var(--step-1);
    font-weight: 700;
    color: var(--accent);
    text-decoration: none;
    letter-spacing: 0.4px;
    line-height: 1.15;
  }

  .sidebar-home:hover {
    color: var(--accent-hover);
  }

  .sidebar-section {
    margin-bottom: 10px;
  }

  .sidebar-heading {
    font-family: var(--font-ui);
    font-size: var(--step--1);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-muted);
    padding: 0 18px;
    margin: 14px 0 4px;
    border: none;
  }

  .sidebar-heading-rule {
    border: none;
    border-top: 2px solid var(--accent);
    width: 28px;
    margin: 4px 0 8px 18px;
    opacity: 0.7;
  }

  .sidebar-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sidebar-item {
    margin: 0;
  }

  .sidebar-link {
    display: block;
    padding: 6px 18px;
    font-family: var(--font-ui);
    font-size: var(--step--1);
    line-height: 1.45;
    color: var(--text-primary);
    text-decoration: none;
    border-left: 3px solid transparent;
    transition: background var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast);
  }

  .sidebar-link:hover {
    background: var(--bg-tertiary);
    color: var(--text-heading);
    text-decoration: none;
  }

  .sidebar-link--active {
    color: var(--accent);
    background: var(--accent-muted);
    border-left-color: var(--accent);
    font-weight: 600;
  }

  .sidebar-footer {
    margin-top: auto;
    padding: 16px 18px;
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  /* ── Mobile drawer ── */
  @media (max-width: 768px) {
    .sidebar {
      width: min(var(--sidebar-width), 86vw);
      transform: translateX(-100%);
      transition: transform var(--transition-base);
      box-shadow: var(--shadow-lg);
      padding-top: 0;
    }

    .sidebar[data-sidebar-open] {
      transform: translateX(0);
    }

    .sidebar-close {
      display: inline-flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sidebar {
      transition: none;
    }
  }
</style>

<script>
  const sidebar = document.querySelector('.sidebar');
  const hamburgerBtn = document.querySelector('.hamburger-btn');
  const overlay = document.querySelector('.sidebar-overlay');
  const closeBtn = document.querySelector('.sidebar-close');

  function openSidebar() {
    if (!sidebar) return;
    sidebar.setAttribute('data-sidebar-open', '');
    hamburgerBtn?.setAttribute('aria-expanded', 'true');
    overlay?.setAttribute('data-visible', '');
    document.body.style.overflow = 'hidden';
    const activeLink = sidebar.querySelector('.sidebar-link--active');
    if (activeLink) activeLink.scrollIntoView({ block: 'center' });
  }

  function closeSidebar() {
    if (!sidebar) return;
    sidebar.removeAttribute('data-sidebar-open');
    hamburgerBtn?.setAttribute('aria-expanded', 'false');
    overlay?.removeAttribute('data-visible');
    document.body.style.overflow = '';
  }

  hamburgerBtn?.addEventListener('click', openSidebar);
  closeBtn?.addEventListener('click', closeSidebar);
  overlay?.addEventListener('click', closeSidebar);

  sidebar?.querySelectorAll('.sidebar-link').forEach((link) => {
    link.addEventListener('click', closeSidebar);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeSidebar();
  });
</script>
