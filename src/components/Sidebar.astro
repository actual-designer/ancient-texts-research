---
// The Chronos Archive — Sidebar Navigation
// Groups: Syntheses (14 documents) + Analyses (14 documents)
import ThemeToggle from './ThemeToggle.astro';

const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL || '/';

interface NavItem {
  label: string;
  href: string;
}

const syntheses: NavItem[] = [
  { label: '00 — INDEX', href: `${base}audit/00-index/` },
  { label: '01 — Entity Registry', href: `${base}audit/01-entity-registry/` },
  { label: '02 — Technology Catalog', href: `${base}audit/02-technology-catalog/` },
  { label: '03 — Event Timeline', href: `${base}audit/03-event-timeline/` },
  { label: '04 — Cross-References', href: `${base}audit/04-cross-references/` },
  { label: '05 — Great Reset', href: `${base}audit/05-great-reset/` },
  { label: '06 — Weapons Doctrine', href: `${base}audit/06-weapons-doctrine/` },
  { label: '07 — Human Project', href: `${base}audit/07-the-human-project/` },
  { label: '08 — Translation Key', href: `${base}audit/08-translation-key/` },
  { label: '09 — Location Registry', href: `${base}audit/09-location-registry/` },
  { label: '10 — Correlation Map', href: `${base}audit/10-correlation-map/` },
  { label: '11 — Unified Hypothesis', href: `${base}audit/11-unified-hypothesis/` },
  { label: '12 — NHI Correlation', href: `${base}audit/12-nhi-correlation/` },
  { label: '13 — NDE Correlation', href: `${base}audit/13-nde-correlation/` },
];

const analyses: NavItem[] = [
  { label: 'Atrahasis', href: `${base}audit/analyses/atrahasis/` },
  { label: 'Book of Enoch', href: `${base}audit/analyses/enoch-watchers/` },
  { label: 'Gilgamesh', href: `${base}audit/analyses/gilgamesh/` },
  { label: 'Ezekiel', href: `${base}audit/analyses/ezekiel-merkabah/` },
  { label: 'Mahābhārata', href: `${base}audit/analyses/mahabharata/` },
  { label: 'Popol Vuh', href: `${base}audit/analyses/popol-vuh/` },
  { label: 'Pyramid Texts', href: `${base}audit/analyses/pyramid-texts/` },
  { label: 'Rig Veda', href: `${base}audit/analyses/rig-veda/` },
  { label: 'Revelation', href: `${base}audit/analyses/revelation/` },
  { label: 'Book of the Dead', href: `${base}audit/analyses/book-of-the-dead/` },
  { label: 'Poetic Edda', href: `${base}audit/analyses/poetic-edda/` },
  { label: 'Theogony & Works and Days', href: `${base}audit/analyses/theogony-works-and-days/` },
  { label: 'Zoroastrian Gathas', href: `${base}audit/analyses/zoroastrian-gathas/` },
  { label: 'Yoga Sutras', href: `${base}audit/analyses/yoga-sutras/` },
];

function isActive(href: string): boolean {
  return currentPath === href || currentPath.replace(/\/$/, '') === href.replace(/\/$/, '');
}
---

<nav class="sidebar" aria-label="Archive Navigation">
  <input type="checkbox" id="sidebar-toggle" class="sidebar-toggle-input" aria-hidden="true" />
  <label for="sidebar-toggle" class="sidebar-toggle-label" aria-label="Toggle navigation menu">
    <span class="hamburger"></span>
  </label>

  <div class="sidebar-content">
    <div class="sidebar-header">
      <a href={base} class="sidebar-home">The Chronos Archive</a>
      <ThemeToggle />
    </div>

    <section class="sidebar-section">
      <h2 class="sidebar-heading">Syntheses</h2>
      <hr class="sidebar-heading-rule" />
      <ul class="sidebar-list">
        {syntheses.map((item) => (
          <li class="sidebar-item">
            <a
              href={item.href}
              class:list={{ 'sidebar-link': true, 'sidebar-link--active': isActive(item.href) }}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="sidebar-section">
      <h2 class="sidebar-heading">Analyses</h2>
      <hr class="sidebar-heading-rule" />
      <ul class="sidebar-list">
        {analyses.map((item) => (
          <li class="sidebar-item">
            <a
              href={item.href}
              class:list={{ 'sidebar-link': true, 'sidebar-link--active': isActive(item.href) }}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <div class="sidebar-footer">&copy; The Chronos Archive</div>
  </div>
</nav>

<style>
  /* ── Sidebar Container ── */
  .sidebar {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: var(--sidebar-width);
    background: var(--bg-secondary);
    border-right: 1px solid var(--border);
    overflow-y: auto;
    z-index: 100;
    display: flex;
    flex-direction: column;
  }

  /* ── Toggle (hidden on desktop) ── */
  .sidebar-toggle-input {
    display: none;
  }

  .sidebar-toggle-label {
    display: none;
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 110;
    width: 36px;
    height: 36px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    align-items: center;
    justify-content: center;
  }

  .hamburger,
  .hamburger::before,
  .hamburger::after {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--text-primary);
    border-radius: 1px;
    position: relative;
    transition: background var(--transition-fast);
  }

  .hamburger::before,
  .hamburger::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .hamburger::before {
    top: -6px;
  }

  .hamburger::after {
    top: 6px;
  }

  /* ── Sidebar Content ── */
  .sidebar-content {
    padding: 16px 0;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .sidebar-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 16px 16px;
    border-bottom: 1px solid var(--divider);
    margin-bottom: 12px;
  }

  .sidebar-home {
    font-family: var(--font-heading);
    font-size: var(--step-0);
    font-weight: 700;
    color: var(--accent);
    text-decoration: none;
    letter-spacing: 0.5px;
  }

  .sidebar-home:hover {
    color: var(--accent-hover);
  }

  .sidebar-section {
    margin-bottom: 8px;
  }

  .sidebar-heading {
    font-family: var(--font-ui);
    font-size: var(--step--1);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    color: var(--text-muted);
    padding: 0 16px;
    margin: 12px 0 4px;
  }

  .sidebar-heading-rule {
    border: none;
    border-top: 2px solid var(--accent);
    width: 30px;
    margin: 4px 0 8px 16px;
    opacity: 0.6;
  }

  .sidebar-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sidebar-item {
    margin: 0;
  }

  .sidebar-link {
    display: block;
    padding: 5px 16px;
    font-family: var(--font-ui);
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--text-primary);
    text-decoration: none;
    transition: background var(--transition-fast), color var(--transition-fast);
    border-left: 3px solid transparent;
  }

  .sidebar-link:hover {
    background: var(--bg-tertiary);
    color: var(--text-heading);
  }

  .sidebar-link--active {
    color: var(--accent);
    background: var(--accent-muted);
    border-left-color: var(--accent);
    font-weight: 500;
  }

  .sidebar-footer {
    margin-top: auto;
    padding: 16px;
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  /* ── Mobile (≤768px) ── */
  @media (max-width: 768px) {
    .sidebar-toggle-label {
      display: flex;
    }

    .sidebar {
      transform: translateX(-100%);
      transition: transform 0.25s ease;
      width: var(--sidebar-width);
    }

    .sidebar-toggle-input:checked ~ .sidebar {
      transform: translateX(0);
    }

    .sidebar-toggle-input:checked ~ .sidebar-toggle-label {
      left: 272px;
    }

    /* overlay when open */
    .sidebar-toggle-input:checked::after {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0, 0, 0, 0.5);
      backdrop-filter: blur(4px);
      z-index: -1;
    }
  }
</style>