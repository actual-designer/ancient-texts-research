---
// The Chronos Archive — Theme Toggle
// Switches between dark (default) and light themes.
// Persists choice to localStorage and adds transition class.
---

<button class="theme-toggle" aria-label="Toggle theme" type="button">
  <svg class="theme-icon theme-icon--moon" width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M15.36 10.04A7.5 7.5 0 0 1 7.96 2.64 7.5 7.5 0 1 0 15.36 10.04Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
  <svg class="theme-icon theme-icon--sun" width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
    <circle cx="9" cy="9" r="3.5" stroke="currentColor" stroke-width="1.5"/>
    <path d="M9 1.5v2M9 14.5v2M1.5 9h2M14.5 9h2M3.4 3.4l1.4 1.4M13.2 13.2l1.4 1.4M3.4 14.6l1.4-1.4M13.2 4.8l1.4-1.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
  </svg>
</button>

<script>
  const toggle = document.querySelector('.theme-toggle');
  if (toggle) {
    toggle.addEventListener('click', () => {
      const html = document.documentElement;
      const isLight = html.getAttribute('data-theme') === 'light';
      const next = isLight ? 'dark' : 'light';

      html.classList.add('theme-transitioning');

      if (next === 'light') {
        html.setAttribute('data-theme', 'light');
        localStorage.setItem('chronos-theme', 'light');
      } else {
        html.removeAttribute('data-theme');
        localStorage.setItem('chronos-theme', 'dark');
      }

      setTimeout(() => {
        html.classList.remove('theme-transitioning');
      }, 300);
    });
  }
</script>

<style>
  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  .theme-toggle:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .theme-icon {
    display: block;
  }

  .theme-icon--sun {
    display: none;
  }

  /* When light theme is active, show sun icon (to switch back to dark) */
  :global([data-theme="light"]) .theme-icon--moon {
    display: none;
  }

  :global([data-theme="light"]) .theme-icon--sun {
    display: block;
  }
</style>