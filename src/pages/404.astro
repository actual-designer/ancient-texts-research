---
// The Chronos Archive — 404 Error Page
// This page does not exist in the Archive.
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL || '/';
---

<BaseLayout title="404 — Page Not Found — The Chronos Archive" description="The requested page does not exist in the Archive.">
  <main class="error-container">
    <div class="error-watermark" aria-hidden="true">404</div>

    <header class="error-header">
      <h1><span class="error-code">404</span> — Page Not Found</h1>
      <p class="error-message">
        This page does not exist in the Archive. The signal you're looking for has not been
        indexed — or never existed in the first place. The amnesia filter does not apply here;
        this is simply a broken link.
      </p>
    </header>

    <section class="diagram-section">
      <h2>You Have Reached Uncharted Territory</h2>
      <p>
        The Archive's infrastructure is organized into three tiers, none of which contain the
        resource you requested:
      </p>
      <pre class="tier-diagram"><code>ORBITAL TIER (Command)
  └── Heaven of Anu / Seventh Heaven / Throne Room
      └── Council / Assembly of the Gods

SURFACE TIER (Operations)
  ├── Enlil — Ground Command / Storm Operations
  ├── Enki — Subsurface R&D / Bioengineering
  ├── Nintu — Genetic Fabrication
  ├── Weapons Custody — Authorized Deployment
  └── Human Settlements — Managed Zones

SUBSURFACE TIER (Restricted)
  ├── Apsu / Abzu — Enki's Domain
  ├── Xibalbá — Trial Facility
  ├── Duat — Post-Mortem Processing
  ├── Tartarus / Prison of Stars — Detention
  └── The Abyss — Terminal Containment</code></pre>
    </section>

    <hr />

    <nav class="return-nav">
      <h2>Return to Known Territory</h2>
      <div class="return-cards">
        <a href={base} class="return-card">
          <span class="return-card-title">Home</span>
          <span class="return-card-desc">The Chronos Archive</span>
          <span class="return-card-arrow">&rarr;</span>
        </a>
        <a href={`${base}audit/00-index/`} class="return-card">
          <span class="return-card-title">00-INDEX</span>
          <span class="return-card-desc">Master Map of the Archive</span>
          <span class="return-card-arrow">&rarr;</span>
        </a>
        <a href="https://github.com/actual-designer/ancient-texts-research#readme" class="return-card">
          <span class="return-card-title">README</span>
          <span class="return-card-desc">Project Overview</span>
          <span class="return-card-arrow">&rarr;</span>
        </a>
      </div>
      <p class="subtitle">
        If you believe this page should exist, verify the link or
        <a href="https://github.com/actual-designer/ancient-texts-research/issues">open an issue</a>
        on the Archive's repository.
      </p>
    </nav>
  </main>
</BaseLayout>

<style>
  .error-container {
    padding-top: 1rem;
    position: relative;
  }

  .error-watermark {
    position: absolute;
    top: -0.3em;
    left: -0.1em;
    font-family: var(--font-heading);
    font-size: calc(var(--step-5) * 2.5);
    font-weight: 700;
    color: var(--text-heading);
    opacity: 0.06;
    line-height: 1;
    pointer-events: none;
    user-select: none;
  }

  .error-header {
    margin-bottom: 2rem;
    position: relative;
  }

  .error-code {
    color: var(--accent);
    font-weight: 700;
  }

  .error-message {
    font-size: var(--step-1);
    color: var(--text-secondary);
    max-width: 640px;
  }

  .diagram-section {
    margin: 2rem 0;
  }

  .tier-diagram {
    background: var(--code-bg);
    border: 1px solid var(--accent-muted);
    border-radius: var(--radius-md);
    padding: 20px 24px;
    font-family: var(--font-mono);
    font-size: 0.875em;
    line-height: 1.6;
    color: var(--code-text);
    overflow-x: auto;
  }

  .tier-diagram code {
    background: none;
    padding: 0;
    border: none;
    color: inherit;
  }

  .return-nav {
    margin-top: 2rem;
  }

  .return-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .return-card {
    display: block;
    padding: var(--space-md) var(--space-lg);
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base);
    box-shadow: var(--shadow-sm);
  }

  .return-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--accent);
  }

  .return-card:hover .return-card-arrow {
    transform: translateX(4px);
  }

  .return-card-title {
    display: block;
    font-family: var(--font-heading);
    font-size: var(--step-1);
    color: var(--text-heading);
    font-weight: 600;
    margin-bottom: var(--space-xs);
  }

  .return-card-desc {
    display: block;
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--text-secondary);
  }

  .return-card-arrow {
    color: var(--accent);
    transition: transform var(--transition-fast);
  }

  .subtitle {
    margin-top: 1.5rem;
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .subtitle a {
    color: var(--accent);
  }

  .subtitle a:hover {
    color: var(--accent-hover);
  }

  @media (max-width: 768px) {
    .return-cards {
      grid-template-columns: 1fr;
    }
  }
</style>